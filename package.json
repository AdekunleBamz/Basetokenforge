{
  "name": "base-token-forge",
  "version": "1.0.0",
  "description": "Deploy your own ERC20 tokens on Base with one click - Standalone app & Farcaster Mini App",
  "main": "index.js",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "postinstall": "cd frontend && npm install",
    "deploy:contracts": "cd contracts && forge script script/Deploy.s.sol:DeployScript --rpc-url $BASE_RPC_URL --broadcast --verify",
    "test": "cd contracts && forge test"
  },
  "keywords": [
    "base",
    "token",
    "factory",
    "erc20",
    "farcaster",
    "mini-app"
  ],
  "author": "",
  "license": "MIT",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdekunleBamz/Basetokenforge.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AdekunleBamz/Basetokenforge/issues"
  },
  "homepage": "https://github.com/AdekunleBamz/Basetokenforge#readme",
  "dependencies": {
    "dotenv": "^17.2.3",
    "viem": "^2.45.1"
  }
}
